library (sdc_lab_min) {
    delay_model : table_lookup;
    time_unit : "1ns";
    voltage_unit : "1V";
    current_unit : "1mA";
    pulling_resistance_unit : "1kohm";
    leakage_power_unit : "1nW";
    capacitive_load_unit (1, pf);

    cell (DFF) {
        area : 1.0;

        ff (IQ, IQN) {
            next_state : "D";
            clocked_on : "CK";
        }

        pin (D) {
            direction : input;
            capacitance : 0.01;

            timing () {
                related_pin : "CK";
                timing_type : setup_rising;
                rise_constraint (scalar) { values ("0.50"); }
                fall_constraint (scalar) { values ("0.50"); }
            }

            timing () {
                related_pin : "CK";
                timing_type : hold_rising;
                rise_constraint (scalar) { values ("0.10"); }
                fall_constraint (scalar) { values ("0.10"); }
            }
        }

        pin (CK) {
            direction : input;
            clock : true;
            capacitance : 0.01;
        }

        pin (Q) {
            direction : output;
            function : "IQ";

            timing () {
                related_pin : "CK";
                timing_type : rising_edge;
                cell_rise (scalar) { values ("0.20"); }
                cell_fall (scalar) { values ("0.20"); }
                rise_transition (scalar) { values ("0.05"); }
                fall_transition (scalar) { values ("0.05"); }
            }
        }
    }
}
